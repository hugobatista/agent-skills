{
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "30 days",
  "dependencyDashboard": true,
  "pinDigests": true,
  "osvVulnerabilityAlerts": true,
  "timezone": "<timezone>",
  "gitAuthor": "<git-author>",
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependency updates"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "matchCategories": [
        "security"
      ],
      "labels": [
        "dependencies",
        "security"
      ],
      "prPriority": 10,
      "groupName": "security updates",
      "dependencyDashboardApproval": false
    }
  ]
}
