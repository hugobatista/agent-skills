name: renovate

on:
  workflow_dispatch:
    inputs:
      dry-run:
        description: Dry run (no changes)
        required: false
        default: false
        type: boolean

  schedule:
    - cron: '0 4 * * *'

# Forgejo ignores the `permissions` key. The token scopes are configured
# on the Forgejo instance, so make sure RENOVATE_TOKEN has write access to
# contents, pull requests, and issues.

concurrency:
  group: ${{ forgejo.workflow }}-${{ forgejo.ref }}
  cancel-in-progress: false

jobs:

  renovate:

    runs-on: <runner-label>

    timeout-minutes: 15

    steps:
      - name: Checkout code
        uses: https://data.forgejo.org/actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1

      - name: Set dry-run mode
        if: ${{ inputs.dry-run == true }}
        run: echo "RENOVATE_DRY_RUN=full" >> "$FORGEJO_ENV"

      - name: Set repository
        run: |
          if [ -z "${RENOVATE_REPOSITORIES:-}" ]; then
            echo "RENOVATE_REPOSITORIES=${{ forgejo.repository }}" >> "$FORGEJO_ENV"
          fi

      - name: Set LOG_LEVEL
        run: |
          if [ -z "${LOG_LEVEL:-}" ]; then
            echo "LOG_LEVEL=info" >> "$FORGEJO_ENV"
          fi

      - name: Run Renovate
        uses: docker://ghcr.io/renovatebot/renovate:44.151.0@sha256:8a79148ec24cc05809782e20e720dafe9dde0c24a00f26e76d14dec2cbd74a53
        env:
          RENOVATE_CONFIG_FILE: renovate.json
          RENOVATE_ENDPOINT: https://<forgejo-instance>/api/v1/
          RENOVATE_PLATFORM: forgejo
          RENOVATE_TOKEN: ${{ secrets.RENOVATE_TOKEN }}
